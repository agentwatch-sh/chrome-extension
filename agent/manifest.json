{
  "manifest_version": 3,
  "name": "agentwatch — agent mode (agent browser only)",
  "version": "0.3.2",
  "description": "For the agent browser only: writes sent sign-ins, blocks sites off each tab's list and carries the agent-mode bridge.",
  "minimum_chrome_version": "145",
  "key": "",
  "permissions": ["cookies", "scripting", "tabs", "webNavigation", "declarativeNetRequest", "nativeMessaging", "debugger", "browsingData", "downloads", "contentSettings", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "block_main_frame", "enabled": true, "path": "rules/block-main-frame.json" },
      { "id": "block_frames", "enabled": true, "path": "rules/block-frames.json" }
    ]
  },
  "background": { "service_worker": "sw.js", "type": "module" }
}
