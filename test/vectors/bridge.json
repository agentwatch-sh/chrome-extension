{
  "contract": "C10, docs/protocol.md. The receiver (stage 2) and the relay (stage 3) check their code against these vectors. Every value is a sample.",
  "constants": {
    "BRIDGE_VERSION": 1,
    "WAIT_DEFAULT_MS": 30000,
    "WAIT_MAX_MS": 600000,
    "WAIT_SLACK_MS": 2000,
    "MAX_IN_FLIGHT": 128,
    "MAX_REQUEST": 134217728,
    "MAX_TO_DAEMON": 8388608,
    "PART_BYTES": 700000,
    "HOLD_MAX_MS": 5000
  },
  "kinds": {
    "id": "an integer of 0 or more: a tab, window or download id",
    "object": "a JSON object",
    "string": "a string that is not empty",
    "boolean": "true or false",
    "target": "{\"tabId\": <id>} or {\"tabId\": <id>, \"sessionId\": \"<child session>\"}, with no other key",
    "contentType": "one of contentTypes"
  },
  "contentTypes": ["location", "notifications", "camera", "microphone", "clipboard", "automaticDownloads"],
  "ops": [
    { "op": "debugger.attach", "args": ["tabId"], "kinds": ["id"], "required": 1, "result": "`{\"already\": <bool>}`" },
    { "op": "debugger.detach", "args": ["tabId"], "kinds": ["id"], "required": 1, "result": "`null`" },
    { "op": "debugger.sendCommand", "args": ["target", "method", "params?"], "kinds": ["target", "string", "object"], "required": 2, "result": "the CDP result" },
    { "op": "debugger.getTargets", "args": [], "kinds": [], "required": 0, "result": "`[TargetInfo]`" },
    { "op": "tabs.create", "args": ["createProperties"], "kinds": ["object"], "required": 1, "result": "`Tab`" },
    { "op": "tabs.get", "args": ["tabId"], "kinds": ["id"], "required": 1, "result": "`Tab`" },
    { "op": "tabs.query", "args": ["queryInfo"], "kinds": ["object"], "required": 1, "result": "`[Tab]`" },
    { "op": "tabs.update", "args": ["tabId", "updateProperties"], "kinds": ["id", "object"], "required": 2, "result": "`Tab`" },
    { "op": "tabs.remove", "args": ["tabId"], "kinds": ["id"], "required": 1, "result": "`null`" },
    { "op": "windows.get", "args": ["windowId", "queryOptions?"], "kinds": ["id", "object"], "required": 1, "result": "`Window`" },
    { "op": "windows.create", "args": ["createData"], "kinds": ["object"], "required": 1, "result": "`Window`" },
    { "op": "windows.update", "args": ["windowId", "updateInfo"], "kinds": ["id", "object"], "required": 2, "result": "`Window`" },
    { "op": "downloads.search", "args": ["query"], "kinds": ["object"], "required": 1, "result": "`[DownloadItem]`" },
    { "op": "downloads.cancel", "args": ["downloadId"], "kinds": ["id"], "required": 1, "result": "`null`" },
    { "op": "contentSettings.set", "args": ["type", "details"], "kinds": ["contentType", "object"], "required": 2, "result": "`null`" },
    { "op": "contentSettings.clear", "args": ["type"], "kinds": ["contentType"], "required": 1, "result": "`null`" },
    { "op": "bridge.info", "args": [], "kinds": [], "required": 0, "result": "an object (below)" },
    { "op": "bridge.attachNew", "args": ["on"], "kinds": ["boolean"], "required": 1, "result": "`null`" },
    { "op": "bridge.release", "args": ["tabId"], "kinds": ["id"], "required": 1, "result": "`null`" }
  ],
