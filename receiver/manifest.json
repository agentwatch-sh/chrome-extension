{
  "manifest_version": 3,
  "name": "agentwatch receiver",
  "version": "0.1.0",
  "description": "Receives signed-in site state for the agent browser and blocks sites off the allowlist.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["cookies", "scripting", "tabs", "webNavigation", "declarativeNetRequest", "nativeMessaging", "debugger", "browsingData"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "block_main_frame", "enabled": true, "path": "rules/block-main-frame.json" }
    ]
  },
  "background": { "service_worker": "sw.js", "type": "module" }
}
