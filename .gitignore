# Per-machine account pin; never committed.
.envrc
.env
.env.local
.direnv/

node_modules/
dist/
*.zip
*.crx
# The committed CRX that agentwatch pins (board task ab-v16.22).
!/release/agent.crx
# The pack's temp file, which it renames to agent.crx (npm run pack:agent -- --out release).
.agent.crx.*.tmp
*.pem

# The live test run folder (profiles, X auth files, logs, screenshots).
test/live/.run/
# Chromium writes indexed rulesets into an unpacked extension it loads.
_metadata/

# Python byte code (test/live/harness_guard.py when a driver imports it).
__pycache__/
